# Supabase (Project Settings -> API). Local dev: values printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54621
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI: set ONE of these keys. Powers exercise lookup, meal parsing, body-scan reading,
# plans and coaching; the rest of the app works without AI.
# OpenAI API key from platform.openai.com/api-keys (API billing, NOT a ChatGPT subscription).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# Claude key from console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# If both keys are set, OpenAI is used unless you force one:
# AI_PROVIDER=openai | anthropic

# USDA FoodData Central (free key at https://fdc.nal.usda.gov/api-key-signup). DEMO_KEY is heavily rate-limited.
USDA_API_KEY=DEMO_KEY
